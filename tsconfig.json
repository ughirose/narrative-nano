{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@schema": ["./node_modules/@worldcraft/schema/src/index.ts"],
      "@schema/*": ["./node_modules/@worldcraft/schema/src/*"],
      "@nano": ["./src/index.ts"],
      "@nano/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
