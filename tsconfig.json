{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@schema": ["./node_modules/@worldcraft/schema/src/index.ts"],
      "@schema/*": ["./node_modules/@worldcraft/schema/src/*"],
      "@core": ["src/*"],
      "@core/*": ["src/*"],
      "@editor": ["src/types/editor.d.ts"],
      "@editor/*": ["src/types/*"],
      "@nano": ["src/index.ts"],
      "@nano/*": ["src/*"]
    }
  },
  "include": ["src/**/*"]
}
