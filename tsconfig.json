{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@schema": ["./packages/schema/src/index.ts"],
      "@schema/*": ["./packages/schema/src/*"],
      "@core": ["./src/index.ts"],
      "@core/*": ["./src/*"],
      "@editor": ["./src/index.ts"],
      "@editor/*": ["./src/*"],
      "@nano": ["./src/index.ts"],
      "@nano/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
